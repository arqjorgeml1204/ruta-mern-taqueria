# Copia este archivo como .env y llena tus datos de MongoDB Atlas (módulo 5).
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_URI="mongodb+srv://USUARIO:CLAVE@TU-CLUSTER.mongodb.net"
MONGODB_DB="restaurante"

# Módulo 6: login con JWT. JWT_SECRET firma los tokens: usa una cadena larga y aleatoria
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). Si alguien la conoce, puede hacerse pasar por el dueño.
JWT_SECRET=""
# Sitios que pueden llamar a la API desde el navegador (CORS), separados por comas
CLIENT_URL="http://localhost:5173"
# La cuenta del dueño la crea «npm run crear-dueno» con estos datos
DUENO_EMAIL=""
DUENO_PASSWORD=""
